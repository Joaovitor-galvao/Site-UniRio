# ===========================================
# Variáveis de Ambiente - Produção
# Copie para .env e preencha os valores
# ===========================================

# Django
DJANGO_SECRET_KEY=gere-com: python -c "import secrets; print(secrets.token_urlsafe(50))"
DEBUG=False
ALLOWED_HOSTS=seudominio.com,www.seudominio.com,seuapp.railway.app
DJANGO_ENV=production

# Database (Railway/Render preenche automaticamente)
# DATABASE_URL=postgresql://user:pass@host:port/dbname

# Django Security
CSRF_TRUSTED_ORIGINS=https://seudominio.com,https://www.seudominio.com

# ===========================================
# Cloudflare R2 / AWS S3 (Media files)
# ===========================================
# AWS_STORAGE_BUCKET_NAME=seu-bucket
# AWS_S3_REGION_NAME=auto
# AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=sua-access-key
# AWS_SECRET_ACCESS_KEY=sua-secret-key

# ===========================================
# Email (SendGrid, Mailgun, AWS SES, etc.)
# ===========================================
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=sua-senha-sendgrid
# DEFAULT_FROM_EMAIL=noreply@seudominio.com

# ===========================================
# Outras configs opcionais
# ===========================================
# REDIS_URL=redis://user:pass@host:port  # Para cache/sessions
# SENTRY_DSN=https://...@sentry.io/...   # Para monitoramento de erros