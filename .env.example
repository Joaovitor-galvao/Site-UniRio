# .env.example - Variáveis de ambiente do Django

# Chave secreta do Django
# Gere uma nova com: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=django-insecure-dev-key-do-not-use-in-production

# Ambiente de debug
# True para desenvolvimento, False para produção
DEBUG=True

# Hosts permitidos (separados por vírgula)
ALLOWED_HOSTS=localhost,127.0.0.1

# Configuração do Banco de Dados
# SQLite para desenvolvimento, PostgreSQL para produção
DATABASE_URL=sqlite:///db.sqlite3

# Produção (ex: Railway, Render)
# DJANGO_SECRET_KEY=gere-uma-chave-segura-aqui
# DEBUG=False
# ALLOWED_HOSTS=.railway.app,seu-dominio.com
# DATABASE_URL=postgresql://user:senha@host:port/db

# Arquivos estáticos e mídia
# WhiteNoise serve arquivos estáticos em produção
# Media files (uploads) - configure S3/R2 em produção para persistência

# Admin e autenticação
# O Django admin já vem com auth padrão
# Para SSO institucional, configure ACCOUNTS_AUTH_BACKEND depois