# Desenvolvimento local
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=troque-por-uma-chave-secreta
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Produção: cole aqui a URL do PostgreSQL fornecida pela hospedagem.
# Exemplo de formato (não use estes valores):
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco?sslmode=require

# Em produção, exemplo:
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=seu-dominio.com,www.seu-dominio.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://seu-dominio.com,https://www.seu-dominio.com
